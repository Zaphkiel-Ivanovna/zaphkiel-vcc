---
import BrandMark from '@/components/BrandMark.astro';
import LanguageSwitcher from '@/components/LanguageSwitcher.astro';
import { SITE_AUTHOR, SITE_TITLE } from '@/consts';
import { messagesFor } from '@/i18n';
import { format } from '@/i18n/format';

const { page } = messagesFor(Astro.currentLocale);
---

<header>
  <div class="container languages"><LanguageSwitcher /></div>
  <div class="container banner">
    <div class="intro">
      <h1>{SITE_TITLE}</h1>
      <p class="author">{format(page.author, { author: SITE_AUTHOR })}</p>
      <p class="lead">{page.lead}</p>
      <p id="stats" class="stats"></p>
    </div>
    <div class="mark"><BrandMark /></div>
  </div>
</header>

<style>
  header {
    background:
      linear-gradient(to bottom, transparent 30%, var(--color-paper)),
      url('../assets/masthead.jpg') center / cover no-repeat,
      var(--color-paper);
    border-bottom: var(--rule);
  }

  .languages {
    display: flex;
    justify-content: flex-end;
    padding-top: var(--space-sm);
  }

  .banner {
    display: flex;
    gap: var(--space-xl);
    align-items: center;
    justify-content: space-between;
    padding-block: var(--space-lg) var(--space-xl);
  }

  .intro {
    min-width: 0;
  }

  h1 {
    margin: 0;
    font-size: var(--text-display);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
    overflow-wrap: anywhere;
  }

  p {
    margin: 0;
  }

  .author {
    margin-top: var(--space-xs);
    font-size: var(--text-lg);
    color: var(--color-ink-2);
  }

  .lead {
    max-width: 46ch;
    margin-top: var(--space-lg);
    font-size: var(--text-lg);
  }

  .stats {
    min-height: 1.5em;
    margin-top: var(--space-sm);
    font: var(--text-sm) / 1.5 var(--font-mono);
    font-variant-numeric: tabular-nums;
    color: var(--color-ink-2);
  }

  .mark {
    flex: none;
    width: clamp(4.5rem, 18vw, 11rem);
  }
</style>
