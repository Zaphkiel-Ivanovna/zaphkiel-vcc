---
import ListingBar from '@/components/ListingBar.astro';
import PackageList from '@/components/PackageList.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '@/consts';
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <header>
    <h1>{SITE_TITLE}</h1>
    <p>Pick the packages you want, then add the listing to the VRChat Creator Companion.</p>
  </header>
  <ListingBar />
  <PackageList />
</BaseLayout>

<script>
  import '@/scripts/package-selector';
</script>

<style>
  h1 {
    margin: 0;
    font-size: 2rem;
    letter-spacing: -0.02em;
  }

  p {
    margin: 0.25rem 0 0;
    color: var(--muted);
  }
</style>
